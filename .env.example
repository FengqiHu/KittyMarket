# Copy to .env and replace the local passwords before sharing this deployment.
DB_USERNAME=kittymarket
DB_PASSWORD=kittymarket-local
DB_ROOT_PASSWORD=kittymarket-root-local
RABBITMQ_USERNAME=kittymarket
RABBITMQ_PASSWORD=kittymarket-local
# Fill in when Qwen is available; an empty key uses local retrieval.
DASHSCOPE_API_KEY=
# Optional embedding model; tongyi vision models use the native DashScope text endpoint.
QWEN_EMBEDDING_MODEL=tongyi-embedding-vision-plus-2026-03-06

# Bounded product embedding concurrency; Qwen batches contain at most 10 products.
RAG_INDEX_CONCURRENCY=4
# LangChain4j score = (cosine similarity + 1) / 2; filter weak semantic matches.
RAG_SEARCH_MIN_SCORE=0.85
RAG_SEARCH_SCORE_WINDOW=0.03

# Per-user API rate limits (anonymous users are grouped by client IP).
# Capacity bounds a burst; refill is the number of requests restored per second.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BURST=20
RATE_LIMIT_REFILL=1
RATE_LIMIT_WRITE_BURST=5
RATE_LIMIT_WRITE_REFILL=0.3333333333333333
RATE_LIMIT_AI_BURST=2
RATE_LIMIT_AI_REFILL=0.16666666666666666
RATE_LIMIT_AUTH_BURST=5
RATE_LIMIT_AUTH_REFILL=0.08333333333333333

# Dify AI customer service configuration (optional; falls back to Qwen/local when empty).
DIFY_API_KEY=
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_TOOL_TOKEN=
